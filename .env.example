# RoverSAR Runtime Configuration
ROVERSAR_HOST=0.0.0.0
ROVERSAR_PORT=8050
ROVERSAR_SIM_HZ=50
ROVERSAR_WATCHDOG_TIMEOUT_MS=500

# Hardware / Firmware WiFi Bridge (copy to .env and fill local values; never commit real credentials)
ROVERSAR_WIFI_SSID=RoverSAR-FieldNet
ROVERSAR_WIFI_PASSWORD=CHANGE_ME_LOCAL_ONLY
ROVERSAR_ROBOT_IP=192.168.4.1
ROVERSAR_CAM_STREAM_URL=http://192.168.4.2:81/stream
