{
  "scenario_id": "comm_loss_500ms_estop",
  "description": "Injects communication loss during manual drive and verifies mandatory <=500ms watchdog motor halt.",
  "dt_s": 0.02,
  "duration_ms": 1200,
  "keep_heartbeat": true,
  "initial_pose": {
    "x_m": -2.2,
    "y_m": 0.0,
    "theta_rad": 0.0
  },
  "events": [
    {
      "at_ms": 40,
      "action": "set_manual",
      "linear_mps": 0.4,
      "angular_rps": 0.0
    },
    {
      "at_ms": 200,
      "action": "inject_comm_loss"
    }
  ],
  "expected": {
    "motors_enabled": false,
    "fault": "COMM_LOSS_500MS"
  }
}
