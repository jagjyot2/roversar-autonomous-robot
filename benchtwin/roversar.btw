{
  "format": "benchtwin-workbench",
  "version": "1.0",
  "project": "RoverSAR",
  "netlist": "roversar.net",
  "bom": "BOM.csv",
  "manifest": "roversar-benchtwin.json",
  "bench_instruments": {
    "dc_supply": { "channel": 1, "voltage_v": 7.4, "current_limit_a": 3.5, "enabled": true },
    "logic_analyzer": {
      "sample_rate_hz": 2000000,
      "channels": [
        { "ch": 0, "net": "I2C_SDA" },
        { "ch": 1, "net": "I2C_SCL" },
        { "ch": 2, "net": "PWMA" },
        { "ch": 3, "net": "PWMB" },
        { "ch": 4, "net": "STBY" },
        { "ch": 5, "net": "ESTOP_HW" },
        { "ch": 6, "net": "ENC_LA" },
        { "ch": 7, "net": "ENC_RA" }
      ]
    },
    "fault_injection": [
      { "id": "estop_open", "target_net": "ESTOP_HW", "action": "open_nc_switch" },
      { "id": "comm_timeout", "target": "U1", "action": "drop_ws_heartbeat_500ms" },
      { "id": "vbat_sag", "target_net": "VBAT_FUSED", "action": "ramp_to_5.8v" }
    ]
  },
  "firmware": {
    "target": "esp32dev",
    "platformio_env": "esp32dev",
    "ws_endpoint": "ws://192.168.4.1/ws/rover"
  }
}
